# .env.example — copie para .env.local e preencha os valores (nunca commite .env.local)

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3 (bucket privado com CORS liberando PUT para http://localhost:3000)
S3_BUCKET=padaria-SEU-GRUPO-1234

# SQS — URL da fila principal (não da DLQ)
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/pedidos-SEU-GRUPO
