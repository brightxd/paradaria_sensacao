# .env.example — copie para .env.local e preencha com os valores reais (nunca commite .env.local)
# Veja AWS_SETUP.md para o passo a passo de onde obter cada valor.

# ─── AWS (credenciais do usuário IAM — Passo 1 do AWS_SETUP.md) ───────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...             # IAM → Users → seu usuário → Security credentials → Access keys
AWS_SECRET_ACCESS_KEY=...             # gerado junto com o Access Key (só aparece uma vez)

# ─── RDS PostgreSQL (Passo 2) ─────────────────────────────────────────────────
# Formato: postgresql://USUARIO:SENHA@ENDPOINT:5432/BANCO
# Endpoint visível em RDS → Databases → seu banco → Connectivity & security
DATABASE_URL=postgresql://padaria:SUA_SENHA@SEU-BANCO.xxxx.us-east-1.rds.amazonaws.com:5432/postgres

# ─── S3 (Passo 3) ─────────────────────────────────────────────────────────────
S3_BUCKET=padaria-SEU-GRUPO          # nome exato do bucket criado no S3

# ─── SQS (Passo 5) ────────────────────────────────────────────────────────────
# URL da fila PRINCIPAL (não da DLQ) — visível em SQS → Queues → sua fila → Details
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/SEU-ACCOUNT-ID/pedidos-SEU-GRUPO

# ─── Admin ────────────────────────────────────────────────────────────────────
ADMIN_PIN=1234                        # PIN de acesso à área /admin (pode trocar)
